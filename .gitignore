# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only learning data + runtime upload folder (never publish kids' material)
# Everything a parent uploads stays on this device. The synthetic samples used by
# `npm run evaluate:ask` live in .agents/skills/ask/fixtures and are restored
# into uploads/ with `npm run seed:samples`.
# The app creates this folder on first upload (app/api/upload/route.ts, lib/ocr-jobs.ts).
/uploads/*

# generated vector store (embeds uploaded material -> local only)
/embeddings/vectors.json

# local OCR spike artifacts + reports
/artifacts/

# OCR language data (tesseract.js fetches it on demand)
*.traineddata

# local dev logs
dev-ocr.log
dev-*.log
server.log

# rendered social videos (large local binaries; re-render with npm run video:social:shots)
/video/out/
