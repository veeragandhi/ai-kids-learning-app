# AmigosNest — Ollama configuration.
# Copy to `.env.local` and adjust. All values have built-in defaults,
# so you only need this file when you differ from them.

# Where Ollama listens. Use the default when the app and Ollama run on the
# same machine; point at your Mac from another machine, e.g.:
#   OLLAMA_BASE_URL=http://192.168.1.50:11434
# On the Mac itself, start Ollama with OLLAMA_HOST=0.0.0.0 so it accepts LAN
# connections:  OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# Generation model for lesson / quiz / ask / video-script.
# Windows CPU default: gemma3:1b
# Mac M1 Pro 16GB picks: gemma3:4b (safe) or qwen3:8b (best quality)
OLLAMA_MODEL=gemma3:4b

# Embedding model. Must match what embeddings/vectors.json was built with —
# if you change this, delete embeddings/vectors.json and re-run:
#   node scripts/reindex-uploads.mjs
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Vision model for the selective scanned-PDF fallback (rare, slow path).
OLLAMA_VISION_MODEL=gemma3:4b

# ── Dual-runtime inference ──────────────────────────────────────────────────
# auto   = use local Ollama when reachable, otherwise the hosted provider
# ollama = force local Ollama (desktop / Tauri mode)
# hosted = force the hosted provider (web mode without local Ollama)
AI_ENGINE=auto

# Hosted provider for Web Browser Mode (server-side only, never shipped to
# the browser). Chat goes through /api/chat; embeddings feed the Supabase
# pgvector store (768 dims, must match vector(768)).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ── Supabase (optional — app runs fully local-only when unset) ──────────────
# Run supabase/migrations/0001_init.sql in the SQL Editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
